{
  "name": "@larastack/mobile",
  "version": "0.0.0",
  "license": "0BSD",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "APP_VARIANT=development expo start",
    "expo:doctor": "npx expo-doctor",
    "android": "APP_VARIANT=development expo start --android",
    "ios": "APP_VARIANT=development expo start --ios",
    "gen:gql": "graphql-codegen --config codegen.ts",
    "gen:gql:watch": "graphql-codegen --config codegen.ts --watch",
    "prets:check": "pnpm run gen:gql",
    "ts:check": "tsc --pretty --skipLibCheck --noEmit",
    "pretest": "pnpm run gen:gql",
    "test": "vitest",
    "pretest:ci": "pnpm run gen:gql",
    "test:ci": "vitest run",
    "pretest:watch": "pnpm run gen:gql",
    "test:watch": "vitest --watch",
    "lint": "oxlint --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --fix --report-unused-disable-directives-severity error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "build:dev:ios": "npx eas-cli@latest build -p ios --profile development",
    "build:dev:android": "npx eas-cli@latest build -p android --profile development",
    "build:prod:ios": "npx eas-cli@latest build -p ios --profile production",
    "build:prod:android": "npx eas-cli@latest build -p android --profile production",
    "build:list": "npx eas-cli@latest build:list",
    "build:view": "npx eas-cli@latest build:view",
    "development-builds": "npx eas-cli@latest workflow:run .eas/workflows/create-development-builds.yml",
    "eas-build-post-install": "pnpm run gen:gql",
    "build:internal:ios": "npx eas-cli@latest build -p ios --profile internal",
    "build:internal:android": "npx eas-cli@latest build -p android --profile internal",
    "submit:internal:ios": "npx eas-cli@latest submit -p ios --profile internal",
    "submit:internal:android": "npx eas-cli@latest submit -p android --profile internal",
    "release:internal": "npx eas-cli@latest workflow:run .eas/workflows/internal.yml",
    "release:production": "npx eas-cli@latest workflow:run .eas/workflows/production.yml"
  },
  "dependencies": {
    "@apollo/client": "4.3.7",
    "@expo/dom-webview": "58.0.2",
    "@expo/metro-runtime": "58.0.17",
    "@react-native-google-signin/google-signin": "17.0.0",
    "@react-native-vector-icons/material-icons": "14.0.0",
    "expo": "58.0.23",
    "expo-apple-authentication": "58.0.2",
    "expo-build-properties": "58.0.12",
    "expo-constants": "58.0.15",
    "expo-dev-client": "58.0.18",
    "expo-device": "58.0.5",
    "expo-font": "58.0.11",
    "expo-haptics": "58.0.7",
    "expo-image": "58.0.18",
    "expo-linking": "58.0.16",
    "expo-router": "58.0.30",
    "expo-secure-store": "58.0.2",
    "expo-splash-screen": "58.0.13",
    "expo-status-bar": "58.0.4",
    "expo-symbols": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.21",
    "expo-web-browser": "58.0.7",
    "graphql": "16.14.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-web": "0.21.4",
    "react-native-worklets": "0.13.0",
    "rxjs": "7.8.2",
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "4.0.1",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/fragment-matcher": "7.1.1",
    "@graphql-codegen/typescript-apollo-client-helpers": "4.0.1",
    "@graphql-typed-document-node/core": "3.2.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "@typescript/native": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-expo": "1.2.1",
    "lightningcss": "1.30.1",
    "tailwindcss": "4.3.5",
    "test-renderer": "1.3.1",
    "typescript": "catalog:",
    "vitest": "5.1.0",
    "vitest-native": "0.14.1"
  }
}
