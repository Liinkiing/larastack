{
  "name": "@larastack/frontend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "graphql-codegen --config codegen.ts && pnpm run gen:panda",
    "dev": "next dev --turbopack",
    "prebuild": "panda codegen && pnpm run gen:gql",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "oxlint --report-unused-disable-directives-severity error",
    "lint:fix": "oxlint --fix --report-unused-disable-directives-severity error",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepare": "panda codegen",
    "gen:panda:watch": "panda codegen --watch",
    "gen:panda": "panda codegen",
    "gen:gql": "graphql-codegen --config codegen.ts",
    "gen:gql:watch": "graphql-codegen --config codegen.ts --watch",
    "prets:check": "panda codegen && pnpm run gen:gql",
    "ts:check": "tsc --pretty --skipLibCheck --noEmit",
    "pretest": "pnpm run gen:gql",
    "test": "vitest",
    "pretest:ci": "pnpm run gen:gql",
    "test:ci": "vitest run",
    "pretest:watch": "pnpm run gen:gql",
    "test:watch": "vitest --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@apollo/client": "4.3.6",
    "@ark-ui/react": "5.40.0",
    "@hookform/resolvers": "7.0.1",
    "apollo-upload-client": "20.0.0",
    "axios": "1.21.0",
    "deepmerge": "4.3.1",
    "graphql": "16.14.2",
    "js-cookie": "3.0.8",
    "motion": "12.43.0",
    "next": "16.4.5",
    "next-transition-router": "0.2.11",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.6.0",
    "@graphql-codegen/add": "7.1.1",
    "@graphql-codegen/cli": "7.4.6",
    "@graphql-codegen/client-preset": "6.2.3",
    "@graphql-codegen/fragment-matcher": "7.1.0",
    "@graphql-codegen/introspection": "6.1.0",
    "@graphql-codegen/typescript-apollo-client-helpers": "4.0.1",
    "@graphql-eslint/eslint-plugin": "4.4.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@pandacss/dev": "1.12.2",
    "@pandacss/shared": "1.12.2",
    "@pandacss/studio": "1.12.2",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/nextjs-vite": "10.6.6",
    "@storybook/react": "10.6.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/apollo-upload-client": "19.0.0",
    "@types/js-cookie": "3.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "catalog:",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint-plugin-storybook": "10.6.6",
    "jsdom": "29.1.1",
    "storybook": "10.6.6",
    "typescript": "catalog:",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
